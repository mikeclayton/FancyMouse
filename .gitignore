.vs
.build
.config
bin
obj
tools

releases

*.user

wiki/anim

# ignore the virtual monitor driver binaries - these are used to
# attach multiple virtual monitors for testing lots of screens
usbmmidd_v2/**

# ignore the generated source code from the WinRT source generator
# (some projects have EmitCompilerGeneratedFiles set to true to
# cache the CsWin32 generated files for committing to source control,
# but even then we don't want to check in WinRT.SourceGenerator files)
**/Generated/WinRT.SourceGenerator/

# CsWin32 writes its generated output here so it can be reviewed locally
# but we don't need to commit them
**/Generated/Microsoft.Windows.CsWin32/

# Win32Gen writes its generated output here so it can be reviewed locally
# but we don't need to commit them
**/Generated/FancyMouse.Win32Gen/
