<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FancyMouse.WinUI3.Tips.TipBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FancyMouse.WinUI3.Tips"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!--
        The settings button sits in its own column so it's always visible regardless of whether a
        tip is currently showing - unlike the tip content, it isn't part of the
        CurrentTip-driven visibility switching.
    -->
    <Border
        Background="#DCDCDC"
        Padding="12,6">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="InfoPanel"
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="InfoIcon"
                    Foreground="Black"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="InfoMessage"
                    Foreground="Black"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    x:Name="RepositoryButton"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="RepositoryButton_Click"
                    ToolTipService.ToolTip="Open the FancyMouse GitHub repository">
                    <Border
                        Padding="8,3,10,3"
                        VerticalAlignment="Center"
                        Background="#E7E6E6"
                        BorderBrush="#7A7A7A"
                        BorderThickness="2"
                        CornerRadius="6">
                        <!--
                            Rounded-pill "badge", echoing wiki\images\fancymouse-banner.png's own
                            pill outline and fill (Background="#E7E6E6" is that banner's own
                            background colour, sampled directly from the source image) - that
                            pill's own corner radius is roughly a sixth of its height (6px against
                            this badge's ~34px height keeps a similar proportion). The wordmark is
                            a pre-cropped, background-keyed-out image (see
                            Assets\fancymouse-wordmark.png's own remarks in the csproj) rather than
                            live text/colours, so it stays pixel-identical to the banner - its
                            Opacity here (and the border's own muted grey instead of pure black) is
                            what tones down the "pop" without needing a re-exported image.
                        -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Image
                                Height="20"
                                VerticalAlignment="Center"
                                Opacity="0.5"
                                Source="ms-appx:///Assets/fancymouse-wordmark.png"
                                Stretch="Uniform" />
                            <!-- TODO: swap the literal "v0.0.1" for the running assembly's own version once
                                 there's an established place to read it from. -->
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="#444444"
                                Text="v0.0.1" />
                        </StackPanel>
                    </Border>
                </Button>
                <Button
                    x:Name="SettingsButton"
                    Padding="6"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SettingsButton_Click"
                    ToolTipService.ToolTip="Settings...">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="16"
                        Foreground="Black"
                        Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
