<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FancyMouse.WinUI3.UI.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FancyMouse.WinUI3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FancyMouse.WinUI3">
    <!--
        PreviewPane fills the window exactly and draws everything itself, including its own
        outer margin and border (the AppWindow is sized/positioned to the pane's own size - see
        PreviewWindow.window.cs).

        The window itself is clipped to a rounded-rectangle region matching the pane's outer
        border (see PreviewWindow.ApplyRoundRectRegion), which also clips away the pane's
        transparent outer margin - an unpackaged WinUI3 window can't get
        real per-pixel alpha transparency from DWM, so this is what actually makes the corners
        outside the rounded border disappear against the real desktop, rather than the border
        image's own transparent corners alone.
    -->
    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <controls:PreviewPane
            x:Name="PreviewPane"
            x:FieldModifier="internal"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />
    </Grid>
</Window>
