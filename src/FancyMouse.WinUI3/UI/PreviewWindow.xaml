<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FancyMouse.WinUI3.UI.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FancyMouse.WinUI3.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FancyMouse.WinUI3">
    <!--
        BorderImage fills the whole window (the AppWindow is already sized/positioned to the
        host box's own outer bounds - see PreviewWindow.xaml.cs) - PreviewPane is positioned
        on top of it via an explicit Margin equal to the host's margin+border thickness, so it
        lines up exactly with the transparent hole in the middle of the border image.
    -->
    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <Image
            x:Name="BorderImage"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False" />
        <local:PreviewPane
            x:Name="PreviewPane"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />
    </Grid>
</Window>
