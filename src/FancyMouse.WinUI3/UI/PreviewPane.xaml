<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FancyMouse.WinUI3.UI.PreviewPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FancyMouse.WinUI3.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!--
        Background and Screenshots are layered in the same Grid cell (z-order follows
        declaration order) - both are sized to fill this control exactly, since they're
        rendered at the same physical-pixel size (see PreviewPane.xaml.cs).
    -->
    <Grid x:Name="RootGrid">
        <Image
            x:Name="BackgroundImage"
            Stretch="Fill"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
        <Image
            x:Name="ScreenshotsImageControl"
            Stretch="Fill"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
    </Grid>
</UserControl>
