<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\Common.Dotnet.Analyzers.props" />
    <Import Project="..\Common.Dotnet.CsWinRT.props" />
    <Import Project="..\Common.Dotnet.props" />

    <PropertyGroup>
        <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
        <RootNamespace>FancyMouse.WinUI3.Controls</RootNamespace>
        <Platforms>x64</Platforms>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <UseWinUI>true</UseWinUI>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    </ItemGroup>

    <ItemGroup>
        <!-- deliberately no reference to FancyMouse.Windows or FancyMouse.Settings - the controls
             only consume the platform-free layout/drawing libraries, so any host can use them -->
        <ProjectReference Include="..\FancyMouse.Drawing\FancyMouse.Drawing.csproj" />
        <ProjectReference Include="..\FancyMouse.Models\FancyMouse.Models.csproj" />
        <ProjectReference Include="..\FancyMouse.Telemetry\FancyMouse.Telemetry.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="PreviewPane.*.cs">
            <DependentUpon>PreviewPane.xaml</DependentUpon>
        </Compile>
        <Compile Update="Editor\ScreenLayoutEditor.*.cs">
            <DependentUpon>ScreenLayoutEditor.xaml</DependentUpon>
        </Compile>
    </ItemGroup>
</Project>
