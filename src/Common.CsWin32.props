<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <!--
          we want visibility of the generated CsWin32 files in the repo so we can
          test the project if the generated Win32 bindings change, so don't generate
          them automatically on every build otherwise we won't know what the CI process
          used for a given build.

          note: process for updating the generated files:

            * set the CsWin32Enabled flag to true
            * update to the latest CsWin32 nuget package
            * build the project, which will update the cached files in the "Generated" folder
            * set the CsWin32Enabled flag back to false
            * test the project to make sure everything works with the latest bindings
            * commit the new "Generated" files to the repo

          this lets us guarantee the content of the generates files used by the CI process, and
          avoids unexpected breaking changes from automatically updating to a new CsWin32 package
        -->
        <CsWin32Enabled Condition="'$(CsWin32Enabled)' == ''">false</CsWin32Enabled>

        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>

    <!--
      don't include the generated files if CsWin32 is enabled
      otherwise we'll get build errors about duplicate definitions from
      the "Generated" folder and the Source Generator both trying to
      define the same types with the same namespaces
    -->
    <ItemGroup Condition="'$(CsWin32Enabled)' == 'true'">
        <Compile Remove="Generated\Microsoft.Windows.CsWin32\**" />
        <EmbeddedResource Remove="Generated\Microsoft.Windows.CsWin32\**" />
        <None Remove="Generated\Microsoft.Windows.CsWin32\**" />
    </ItemGroup>

    <!--
      only include the generated files if CsWin32 is enabled
      otherwise we'll get build errors about duplicate definitions from
      the "Generated" folder and the Source Generator both trying to
      define the same types with the same namespaces
    -->
    <ItemGroup Condition="'$(CsWin32Enabled)' == 'true'">
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.269">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
