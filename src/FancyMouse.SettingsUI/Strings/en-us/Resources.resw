  <!--
    Ported from PowerToys' Strings/en-us/Resources.resw - keys mirror MouseUtils_MouseJump_*
    (prefixed FancyMouse_ instead - see FancyMousePane.xaml's own remarks). Values reuse
    MouseJump's own wording verbatim wherever it's accurate for FancyMouse too (British "colour"
    spelling throughout, matching this project's own established convention - MouseJump uses
    American "color"), including Description text MouseJump has that this file didn't carry
    before. Two deliberate exceptions, where copying MouseJump's literal wording would misdescribe
    FancyMouse: FancyMouse.Header/FancyMouse_ActivationShortcut.Description - see their own
    comments below for why.
  -->
  <!-- Not "Mouse Jump" -> "FancyMouse": this labels the settings group, and the window's own
       title bar already reads "FancyMouse Settings" directly above it, so repeating the utility
       name here would be redundant in a way it isn't for MouseJump (one of several sibling
       module groups on a shared page, where the name is what tells them apart) - kept as this
       project's own descriptive text instead. No Description either, for the same reason
       MouseUtils_MouseJump.Description ("Quickly move the mouse pointer long distances.") isn't
       reused - that describes MouseJump's own cursor-jumping behaviour, not FancyMouse's. -->
  <data name="FancyMouse.Header" xml:space="preserve">
    <value>Settings</value>
  </data>
  <data name="FancyMouse_ActivationShortcut.Header" xml:space="preserve">
    <value>Activation shortcut</value>
  </data>
  <!-- Not MouseUtils_MouseJump_ActivationShortcut.Description's wording ("...used to turn this
       mode on or off") - FancyMouse's hotkey doesn't toggle a mode, it shows the preview window
       (a momentary action), so that phrasing would be inaccurate here. -->
  <data name="FancyMouse_ActivationShortcut.Description" xml:space="preserve">
    <value>Customize the shortcut used to show the preview window</value>
  </data>
