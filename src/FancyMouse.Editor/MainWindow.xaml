<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FancyMouse.Editor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:editor="using:FancyMouse.WinUI3.Controls.Editor"
    mc:Ignorable="d"
    Title="FancyMouse Editor">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        Laid out like a Windows Settings page - title, description, then the editor in a card (the
        editor brings its own tool strip) - so it can later drop into FancyMouse.SettingsUI unchanged.
    -->
    <Grid Padding="40,32,40,32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Preview layout" Style="{StaticResource TitleTextBlockStyle}" />

        <TextBlock
            Grid.Row="1"
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Design where each screen appears in the preview. Drag a screen to move it, or drag one of its corners to resize it. The preview window's border follows the screens, and can grow up to the configured preview size (the dotted line). Where screens overlap, use the layer tools to choose which one is in front. Scroll to zoom, and drag the background to pan. Changes aren't saved." />

        <Border
            Grid.Row="2"
            Padding="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <editor:ScreenLayoutEditor x:Name="LayoutEditor" />
        </Border>
    </Grid>
</Window>
