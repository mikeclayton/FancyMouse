<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\Common.Dotnet.Analyzers.props" />
    <Import Project="..\Common.Dotnet.CsWin32.props" />
    <Import Project="..\Common.Dotnet.props" />

    <PropertyGroup>
        <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Platforms>x64</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="images\icon.ico" />
        <EmbeddedResource Include="images\icon.ico" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FancyMouse.Drawing\FancyMouse.Drawing.csproj" />
        <ProjectReference Include="..\FancyMouse.Models\FancyMouse.Models.csproj" />
        <ProjectReference Include="..\FancyMouse.Telemetry\FancyMouse.Telemetry.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- GDI+ is still used here (Windows-only anyway) for desktop capture via StretchBlt
             and for the tray icon's Icon - the shared drawing code uses SkiaSharp instead -->
        <PackageReference Include="System.Drawing.Common" Version="10.0.8" />
    </ItemGroup>
</Project>