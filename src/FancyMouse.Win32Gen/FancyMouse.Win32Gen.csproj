<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\Common.Dotnet.Analyzers.props" />

    <PropertyGroup>
        <!-- analyzers must be based on netstandard - not importing
             Common.Dotnet.CsWinRT.props because it's for WinRT-projecting
             Windows apps; this project has no WinRT dependency, and
             importing it anyway (with RuntimeIdentifier set, as CI's build
             does) makes the CsWinRT.targets projection step run against this
             netstandard2.0 output and fail with a garbled cswinrt.exe
             command line -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsRoslynComponent>true</IsRoslynComponent>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <EnforceExtendedAnalyzerRules>false</EnforceExtendedAnalyzerRules>
        <Platforms>x64</Platforms>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <!-- these are hand-authored fragments (Source\Functions\*.cs is a bare
             method with no enclosing class/namespace; Source\Framework\*.cs
             is missing only its namespace), not standalone C#, so they can't
             be Compile items - embed them instead and read them back at
             generate time -->
        <Compile Remove="Source\**\*.cs" />
        <None Remove="Source\**\*.cs" />
        <EmbeddedResource Include="Source\**\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- required by RS2008 (Microsoft.CodeAnalysis.Analyzers) since this
             generator now defines DiagnosticDescriptors of its own -->
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
        <!-- CodeFixProvider/CodeAction live at the workspace layer, not the
             compiler layer - Microsoft.CodeAnalysis.CSharp alone (enough
             for the DiagnosticAnalyzer/IIncrementalGenerator above) doesn't
             carry them. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" PrivateAssets="all" />
        <!-- for reading the raw ECMA-335 tables of the win32metadata .winmd
             file - explicit (rather than relying on it being a transitive
             dependency of Microsoft.CodeAnalysis.CSharp) so it resolves
             predictably regardless of Roslyn version -->
        <PackageReference Include="System.Reflection.Metadata" Version="8.0.0" PrivateAssets="all" />
        <!-- CsWin32\ drives CsWin32's own Generator directly (see
             CsWin32\CsWin32Helper.cs) - CsWin32 ships its analyzer
             assemblies only under analyzers/cs, which NuGet wires up as a
             live analyzer for whatever references it, not as a normal
             compile-time Reference. ExcludeAssets="analyzers" stops CsWin32
             itself from running as an analyzer against this project's own
             compilation (it has no NativeMethods.txt here to act on, so
             would just be dead weight); the specific DLLs CsWin32\ needs
             are added as plain References below instead, via the $(Pkg...)
             property NuGet defines for every referenced package regardless
             of asset selection. -->
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.269" PrivateAssets="all" ExcludeAssets="analyzers" />
       
    </ItemGroup>

    <ItemGroup>
        <!-- Microsoft.Windows.CsWin32.Generator/GeneratorOptions/Docs -
             ExcludeAssets="analyzers" above means these don't come in as a
             normal Reference either, so they're added explicitly here. -->
        <Reference Include="Microsoft.Windows.CsWin32">
            <HintPath>$(PkgMicrosoft_Windows_CsWin32)\analyzers\cs\Microsoft.Windows.CsWin32.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

</Project>
